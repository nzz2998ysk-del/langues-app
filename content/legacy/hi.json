 "grammar": [
  {
   "id": "g0",
   "level": "A1",
   "title": {
    "fr": "Ordre des mots"
   },
   "body": {
    "fr": "<p>Le hindi suit l'ordre Sujet-Objet-Verbe : « मैं चाय पीता हूँ » (je thé bois).</p>"
   }
  },
  {
   "id": "g1",
   "level": "A1",
   "title": {
    "fr": "Postpositions"
   },
   "body": {
    "fr": "<p>Au lieu de prépositions avant le nom, le hindi utilise des postpositions après : घर में (dans la maison).</p>"
   }
  },
  {
   "id": "g2",
   "level": "A1",
   "title": {
    "fr": "Genre grammatical"
   },
   "body": {
    "fr": "<p>Les noms et adjectifs sont masculins ou féminins, ce qui change la forme du verbe.</p>"
   }
  }
 ],
