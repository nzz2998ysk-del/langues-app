 "grammar": [
  {
   "id": "g0",
   "level": "A1",
   "title": {
    "fr": "Deux verbes « être »"
   },
   "body": {
    "fr": "<p>Le portugais distingue ser (état permanent : Sou francês) et estar (état temporaire : Estou cansado).</p>"
   }
  },
  {
   "id": "g1",
   "level": "A1",
   "title": {
    "fr": "Le genre des noms"
   },
   "body": {
    "fr": "<p>Les noms sont masculins (-o) ou féminins (-a) : o livro / a mesa. Les adjectifs s'accordent : o livro vermelho / a mesa vermelha.</p>"
   }
  },
  {
   "id": "g2",
   "level": "A1",
   "title": {
    "fr": "Le pluriel"
   },
   "body": {
    "fr": "<p>On ajoute -s en général : livro → livros. Les mots en -ão ont souvent un pluriel en -ões : coração → corações.</p>"
   }
  },
  {
   "id": "g3",
   "level": "A1",
   "title": {
    "fr": "Conjugaison au présent"
   },
   "body": {
    "fr": "<p>Les verbes en -ar suivent un modèle régulier : falar → falo, falas, fala, falamos, falam.</p>"
   }
  },
  {
   "id": "g4",
   "level": "A2",
   "title": {
    "fr": "La négation"
   },
   "body": {
    "fr": "<p>On place não avant le verbe : Não falo russo (je ne parle pas russe).</p>"
   }
  },
  {
   "id": "g5",
   "level": "A2",
   "title": {
    "fr": "Poser une question"
   },
   "body": {
    "fr": "<p>À l'oral, l'intonation suffit souvent : Falas português? On peut aussi utiliser des mots interrogatifs : Onde?, Quando?, Porquê?</p>"
   }
  }
 ],
 "readings": [
  {
   "id": "r0",
   "level": "A1",
   "title": "Lecture",
   "t": "Olá! Chamo-me Maria. Sou francesa. Hoje está sol, quero ir ao parque. Gosto de beber café, mas não gosto de chá. Na minha família há o meu pai, a minha mãe e um irmão.",
   "r": "",
   "tr": {
    "fr": "Bonjour ! Je m'appelle Marie. Je suis française. Aujourd'hui il fait soleil, je veux aller au parc. J'aime boire du café, mais je n'aime pas le thé. Dans ma famille il y a mon père, ma mère et un frère."
   },
   "q": []
  }
 ]
}
