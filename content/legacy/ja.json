 "grammar": [
  {
   "id": "g0",
   "level": "A1",
   "title": {
    "fr": "Ordre Sujet-Objet-Verbe"
   },
   "body": {
    "fr": "<p>Le verbe se place toujours à la fin : 私はお茶を飲みます (watashi wa ocha o nomimasu) = « je thé bois ».</p>"
   }
  },
  {
   "id": "g1",
   "level": "A1",
   "title": {
    "fr": "Les particules"
   },
   "body": {
    "fr": "<p>De petits mots après chaque groupe indiquent sa fonction : は (thème), を (objet), に/へ (direction), で (lieu de l'action).</p>"
   }
  },
  {
   "id": "g2",
   "level": "A1",
   "title": {
    "fr": "Pas de genre ni de pluriel"
   },
   "body": {
    "fr": "<p>Les noms ne changent jamais : 本 (hon) veut dire « livre » ou « livres » selon le contexte.</p>"
   }
  },
  {
   "id": "g3",
   "level": "A1",
   "title": {
    "fr": "Politesse en -masu"
   },
   "body": {
    "fr": "<p>La forme polie standard des verbes se termine en ます : 食べます (je mange, poliment), forme du dictionnaire : 食べる.</p>"
   }
  },
  {
   "id": "g4",
   "level": "A2",
   "title": {
    "fr": "La négation"
   },
   "body": {
    "fr": "<p>On change la terminaison du verbe : 食べます → 食べません (je ne mange pas).</p>"
   }
  },
  {
   "id": "g5",
   "level": "A2",
   "title": {
    "fr": "Poser une question"
   },
   "body": {
    "fr": "<p>On ajoute simplement か à la fin de la phrase, sans changer l'ordre des mots : お茶を飲みますか？ (bois-tu du thé ?).</p>"
   }
  }
 ],
 "readings": [
  {
   "id": "r0",
   "level": "A1",
   "title": "Lecture",
   "t": "こんにちは。私はマリーです。フランス人です。 今日はいい天気です。公園に行きたいです。 私はお茶が好きです。コーヒーは好きじゃないです。 私の家族には父と母と兄がいます。",
   "r": "",
   "tr": {
    "fr": "Bonjour. Je m'appelle Marie. Je suis française. Aujourd'hui il fait beau. Je veux aller au parc. J'aime le thé. Je n'aime pas le café. Dans ma famille il y a mon père, ma mère et un grand frère."
   },
   "q": []
  }
 ]
}
