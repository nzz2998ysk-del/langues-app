 "grammar": [
  {
   "id": "g0",
   "level": "A1",
   "title": {
    "fr": "Pas de conjugaison"
   },
   "body": {
    "fr": "<p>Les verbes ne changent jamais de forme ; le temps est marqué par des mots placés avant : mwen ap manje (je mange/suis en train de manger).</p>"
   }
  },
  {
   "id": "g1",
   "level": "A1",
   "title": {
    "fr": "Vocabulaire d'origine française"
   },
   "body": {
    "fr": "<p>Beaucoup de mots sont reconnaissables pour un francophone, mais la grammaire est très différente.</p>"
   }
  },
  {
   "id": "g2",
   "level": "A1",
   "title": {
    "fr": "Orthographe phonétique"
   },
   "body": {
    "fr": "<p>Contrairement au français, le créole haïtien s'écrit exactement comme il se prononce.</p>"
   }
  }
 ],
