# Pap’pote — environment variables.
# Copy to .env for local development if you like (it is NOT loaded
# automatically: export the variables or use `node --env-file=.env server.js`).
# In production, set every value in Render: service -> Settings -> Environment.
# Never commit real secrets: .env is git-ignored, this file holds placeholders only.

# --- Required ---------------------------------------------------------------
JWT_SECRET=change-me-long-random-string
DATABASE_URL=postgresql://user:pass@localhost:5432/langues_app
# The account with this address becomes administrator once it has confirmed
# the address (link in the welcome email, or a password-reset link). No default.
ADMIN_EMAIL=ton-email@exemple.com

# --- Transactional email (SendGrid HTTP API) ---------------------------------
# Welcome, password reset, invoices (PDF attached), reminders and the ideas
# digest go through SendGrid's HTTPS API (Render's free plan blocks outbound
# SMTP). Without SENDGRID_API_KEY the app runs normally and logs
# "[email] SENDGRID_API_KEY not set - skipping ...".
# RESEND_API_KEY / SMTP_* / GMAIL_* are no longer used.
#
# SENDGRID_API_KEY: SendGrid -> Settings -> API Keys -> Create API Key
#   (Restricted access, "Mail Send"). Paste it ONLY into Render -> Environment.
SENDGRID_API_KEY=
#
# EMAIL_FROM: optional sender, default "Pap’pote <papotelangues@icloud.com>".
#   The address must be verified in SendGrid -> Settings -> Sender
#   Authentication (Single Sender, or a whole authenticated domain).
EMAIL_FROM=

# --- Invoices ----------------------------------------------------------------
# VAT mention printed on invoices. Default (micro-entreprise):
#   "TVA non applicable, art. 293 B du CGI". Set it if you charge VAT.
INVOICE_VAT_NOTE=

# --- Optional ---------------------------------------------------------------
APP_URL=https://langues-app.onrender.com
BUSINESS_NAME=Pap’pote
DIGEST_EMAIL=
DIGEST_HOUR_LOCAL=22
DIGEST_CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Premium with a 12-month commitment, and the two customer portal configurations.
STRIPE_PRICE_ID_COMMIT=
STRIPE_PORTAL_CONFIG=
STRIPE_PORTAL_CONFIG_COMMITTED=
# Not offered for now: STRIPE_PRICE_ID_ULTRA=
# AI messages per day for Ultra (default 1000).
# AI_DAILY_ULTRA=1000
# Stripe webhook events to enable: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Database TLS: auto (verify the certificate, fall back only if impossible),
# verify, no-verify or disable.
DATABASE_SSL=auto
# PEM certificate of the PostgreSQL server, to verify the database TLS
# connection strictly (optional; without it TLS is used unverified).
DATABASE_SSL_CA=

# --- Legal notice / privacy policy (shown on /mentions-legales, /confidentialite)
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_SIRET=
LEGAL_DIRECTOR=

# --- Admin two-factor authentication: key used to encrypt the TOTP secrets.
# Optional (defaults to JWT_SECRET). If you change it (or JWT_SECRET without
# it), admins must set up 2FA again: UPDATE users SET totp_enabled=false ...
TOTP_ENC_KEY=

# --- AI conversation partner (optional). Set the key ONLY in the hosting
# environment (Render -> Environment), never in the code or a commit.
ANTHROPIC_API_KEY=
# Model used (default claude-sonnet-5-5) and daily message quotas per account.
AI_MODEL=
AI_DAILY_FREE=10
AI_DAILY_PREMIUM=150

# --- Referral: days of Premium offered to whoever invited a friend who subscribes.
REFERRAL_DAYS=30
